   "source": [
    "import sqlite3\n",
    "import pandas as pd\n",
    "\n",
    "con = sqlite3.connect(\"../data/processed/engine.db\")\n",
    "\n",
    "query = \"\"\"\n",
    "SELECT split, COUNT(*) AS n_rows, COUNT(DISTINCT unit) AS n_engines\n",
    "FROM readings\n",
    "GROUP BY split\n",
    "\"\"\"\n",
    "pd.read_sql(query, con)"
   ]
  },
